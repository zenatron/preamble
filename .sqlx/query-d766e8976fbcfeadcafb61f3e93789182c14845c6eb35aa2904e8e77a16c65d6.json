{
  "db_name": "SQLite",
  "query": "SELECT file_hash,\n        COUNT(*) AS n,\n        MIN(title) AS title,\n        MIN(artist) AS artist,\n        MIN(album) AS album\n        FROM tracks\n        WHERE file_hash IS NOT NULL AND marked_for_deletion = 0\n        GROUP BY file_hash\n        HAVING COUNT(*) > 1\n        ORDER BY n DESC, artist, album, title",
